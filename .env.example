# Key to open the guest list page: /guests?key=YOUR_KEY
ADMIN_KEY=change-me

# Optional: Upstash Redis (needed on Vercel, where the file system is read-only)
# Leave empty to save RSVPs in data/rsvps.json (works locally / on a normal server)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your live URL, used for the WhatsApp/link preview image
NEXT_PUBLIC_SITE_URL=https://your-domain.com
